// Code generated by go/tools/errcodes from taxonomy/error-codes.yaml; DO NOT EDIT.

package errors

// The error codes, one per row of taxonomy/error-codes.yaml.
const (
{{- range $i, $c := .}}
{{- if $i}}
{{end}}
{{goComment "\t" (printf "%s is %s: %s." $c.Go $c.Doc (facts $c))}}
{{- if $c.Note}}
	//
{{goComment "\t" $c.Note}}
{{- end}}
	{{$c.Go}} ErrorCode = "{{$c.Code}}"
{{- end}}
)

// Codes returns every error code, in taxonomy order.
func Codes() []ErrorCode {
	return []ErrorCode{
{{- range .}}
		{{.Go}},
{{- end}}
	}
}

// infoOf returns code's taxonomy row; ok is false for a code the taxonomy does not
// declare.
func infoOf(code ErrorCode) (codeInfo, bool) {
	switch code {
{{- range .}}
	case {{.Go}}:
		return codeInfo{
			http:  {{.HTTP}},
			grpc:  {{.GRPCNumber}}, // {{.GRPC}}
			retry: retry{{upper .Retry}},
{{- if .SafeMessage}}
			safeMessage: {{printf "%q" .SafeMessage}},
{{- end}}
{{- if .HideMessage}}
			hideMessage: true,
{{- end}}
		}, true
{{- end}}
	default:
		return codeInfo{}, false
	}
}
